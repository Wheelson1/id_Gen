# .env.example — Copy to .env for local Supabase CLI dev.
# .env is gitignored.  Never commit real credentials.
#
# These values are also set as Supabase secrets for production:
#   supabase secrets set KEY=VALUE

# ── Supabase project (auto-set by Supabase CLI in Edge Functions) ─────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # functions only, never client

# ── Signing keys ───────────────────────────────────────────────────────────────
# Generate with:  deno run supabase/scripts/generate-keys.ts
ED25519_PRIVATE_KEY=BASE64_PKCS8_PRIVATE_KEY      # functions only, never client
ED25519_PUBLIC_KEY=BASE64_RAW_32_BYTE_PUBLIC_KEY  # safe to expose in client config

# ── Verification source ────────────────────────────────────────────────────────
# 'supabase' (default) — reads from the students table
# 'portal'             — calls the EBSU ICT portal REST API (see PortalSource adapter)
VERIFICATION_SOURCE=supabase

# ── School portal API (only needed when VERIFICATION_SOURCE=portal) ────────────
# TODO: Obtain real values from EBSU ICT
PORTAL_API_BASE=https://portal.ebsu.edu.ng/api/v1
PORTAL_API_KEY=YOUR_PORTAL_API_KEY
